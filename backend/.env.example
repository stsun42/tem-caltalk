# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/caltalk
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/caltalk_test

# JWT
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Long Polling
LONG_POLL_TIMEOUT_MS=20000
